# Credentials for the optional --adjudicate / --enrich LLM tiers.
# Both are OFF unless you pass the flag; the scanner's only network calls are
# `git clone` and this endpoint. Copy this file to `.env` and fill in.
# `.env` is gitignored — never commit your key.

# --- Required: your key (real OpenAI, Azure OpenAI, or an internal gateway) ---
OPENAI_API_KEY=sk-...

# --- Optional: the "flex" endpoint URL. LEAVE THIS COMMENTED for real OpenAI.
# It defaults to https://api.openai.com/v1 when unset. Only uncomment and set a
# real https:// URL if you use a gateway or Azure OpenAI.
# AISCAN_ADJUDICATE_BASE_URL=https://gw.internal.example/v1

# --- Optional: model for both tiers. Defaults to gpt-4o-mini. ---
# AISCAN_ADJUDICATE_MODEL=gpt-4o-mini

# --- Optional: max adjudication calls per scan. Defaults to 20. ---
# AISCAN_ADJUDICATE_BUDGET=20

# --- Optional: a dedicated key just for these tiers (overrides OPENAI_API_KEY).
# AISCAN_ADJUDICATE_API_KEY=sk-...
